2025-08-20 18:10:07,597 - nodes - INFO - tool_name:create_file,tool_args:{'file_name': 'analysis_step_relationship.py', 'file_contents': 'import pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\n# 读取数据\nfile_path = \'student_habits_performance.csv\'\ndata = pd.read_csv(file_path)\n\n# 统一列名格式，方便调用\nprint("原始列名：", data.columns.tolist())\ndata.columns = [col.strip().lower() for col in data.columns]\nprint("统一格式后列名：", data.columns.tolist())\n\n# 相关性分析所用的关键字段，前提是成绩列名一般为 exam_score\nscore_col = \'exam_score\'\n# 习惯相关列剔除非数值进行相关性分析，选取数值类型列\nhabit_cols = data.select_dtypes(include=[\'float64\', \'int64\']).columns.tolist()\n# 移除ID列及成绩列\nhabit_cols = [col for col in habit_cols if col not in [\'id\', score_col]]\nprint(f"用于相关性分析的习惯指标列：{habit_cols}")\n\n# 计算相关系数矩阵（针对成绩和习惯指标）\ncorr_matrix = data[[score_col] + habit_cols].corr(method=\'pearson\')\nprint("成绩与各习惯指标的相关系数（前10的正相关和负相关）：")\n# 除去成绩本身，排序正负相关最大10个\ncorr_with_score = corr_matrix[score_col].drop(labels=[score_col])\ncorr_with_score_sorted = corr_with_score.sort_values(ascending=False)\nprint(corr_with_score_sorted.head(10))\nprint(corr_with_score_sorted.tail(10))\n\n# 画出成绩与相关度较大的前5正相关和5负相关变量的散点图\ntop_pos_corr_vars = corr_with_score_sorted[corr_with_score_sorted > 0].head(5).index.tolist()\ntop_neg_corr_vars = corr_with_score_sorted[corr_with_score_sorted < 0].tail(5).index.tolist()\n\n# 只对这些显著相关变量画散点图\nfor var in top_pos_corr_vars + top_neg_corr_vars:\n    plt.figure(figsize=(6, 4))\n    sns.scatterplot(x=data[var], y=data[score_col])\n    plt.title(f\'成绩与{var}的关系散点图\')\n    plt.xlabel(var)\n    plt.ylabel(\'成绩\')\n    plt.tight_layout()\n    plt.savefig(f\'score_vs_{var}.png\')\n    plt.close()\n\n# 绘制成绩及相关习惯指标的相关性热力图\nplt.figure(figsize=(10, 8))\nsns.heatmap(data[[score_col] + top_pos_corr_vars + top_neg_corr_vars].corr(), annot=True, cmap=\'coolwarm\', fmt=\'.2f\')\nplt.title(\'成绩与主要习惯指标相关性矩阵热力图\')\nplt.tight_layout()\nplt.savefig(\'score_habit_correlation_heatmap.png\')\nplt.close()\n\nprint("相关系数矩阵热力图和散点图已保存完毕。")\n\n# 保存相关系数结果到文件\nwith open(\'correlation_analysis_result.txt\', \'w\', encoding=\'utf-8\') as f:\n    f.write(\'成绩与各习惯指标相关系数（前10正相关关键词，后10负相关关键词）\\n\')\n    f.write(str(corr_with_score_sorted.head(10)))\n    f.write(\'\\n\')\n    f.write(str(corr_with_score_sorted.tail(10)))\n\nprint("相关系数分析结果已保存至correlation_analysis_result.txt。")\n'}
