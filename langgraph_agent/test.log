2025-08-20 18:07:31,793 - nodes - INFO - tool_name:create_file,tool_args:{'file_name': 'plot_student_habits.py', 'file_contents': "import pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\n# 读取数据\nfile_path = 'student_habits_performance.csv'\ndata = pd.read_csv(file_path)\n\n# 去除字段名多余空格\ndata.columns = data.columns.str.strip()\n\n# 设置绘图风格\nsns.set(style='whitegrid')\n\n# 需要绘制图形的关键指标字段\n# 选定数值型且与学生习惯相关的字段\nfields = ['Age', 'Study_Time', 'Social_Media_Time', 'Netflix_Time', 'Class_Attendance', 'Sleep_Hours', 'Exercise_Frequency', 'Mental_Health_Score', 'Exam_Score']\n\nfor field in fields:\n    plt.figure(figsize=(10, 5))\n    # 直方图\n    plt.subplot(1, 2, 1)\n    sns.histplot(data[field], kde=False, bins=30, color='skyblue')\n    plt.title(f'Histogram of {field}')\n\n    # 箱线图\n    plt.subplot(1, 2, 2)\n    sns.boxplot(x=data[field], color='lightgreen')\n    plt.title(f'Boxplot of {field}')\n\n    plt.tight_layout()\n    plt.savefig(f'{field}_distribution.png')\n    print(f'已绘制字段{name}的直方图和箱线图')\n    plt.close()\n"}
