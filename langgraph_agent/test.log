2025-08-20 18:09:09,600 - nodes - INFO - tool_name:create_file,tool_args:{'file_name': 'step_relationship_analysis.py', 'file_contents': 'import pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\n# 读取数据\nfile_path = \'student_habits_performance.csv\'\ndata = pd.read_csv(file_path)\n\n# 去除列名多余空格\ndata.columns = data.columns.str.strip()\n\n# 选择数值列进行相关性分析，过滤掉非数值列\nnum_cols = data.select_dtypes(include=[\'number\']).columns.tolist()\n\n# 计算相关系数矩阵\ncorr = data[num_cols].corr()\nprint("相关系数矩阵:")\nprint(corr[\'Exam_Score\'].sort_values(ascending=False))  # 与成绩的相关系数排序\n\n# 绘制相关系数热图（包含成绩）\nplt.figure(figsize=(12, 10))\nsns.heatmap(corr, annot=True, fmt=\'.2f\', cmap=\'coolwarm\', square=True)\nplt.title(\'学生习惯及成绩的相关系数矩阵热图\')\nplt.tight_layout()\nplt.savefig(\'correlation_matrix_heatmap.png\')\nplt.close()\n\n# 选取与成绩相关性最高的前10个习惯指标（成绩列除外）\n# 相关系数排序，去除Exam_Score自身\ntop_corr = corr[\'Exam_Score\'].drop(\'Exam_Score\').abs().sort_values(ascending=False).head(10)\nprint("与成绩相关性最高的前10个习惯指标:")\nprint(top_corr)\n\n# 绘制这些指标与成绩的散点图\nfor feature in top_corr.index:\n    plt.figure(figsize=(6, 4))\n    sns.scatterplot(x=data[feature], y=data[\'Exam_Score\'])\n    plt.title(f\'{feature}与考试成绩的散点图\')\n    plt.xlabel(feature)\n    plt.ylabel(\'考试成绩\')\n    plt.tight_layout()\n    plt.savefig(f\'scatter_{feature}_vs_exam_score.png\')\n    plt.close()\n\nprint(\'分析完成，相关系数矩阵热图和散点图已保存。\')\n'}
